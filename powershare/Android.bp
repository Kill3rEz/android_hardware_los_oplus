cc_binary {
    name: "vendor.aospa.powershare-service.oplus",
    vintf_fragments: ["vendor.aospa.powershare-service.oplus.xml"],
    init_rc: ["vendor.aospa.powershare-service.oplus.rc"],
    vendor: true,
    relative_install_path: "hw",
    srcs: [
        "PowerShare.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "liblog",
        "libbinder_ndk",
        "libutils",
        "vendor.aospa.powershare-V1-ndk",
    ],
}
