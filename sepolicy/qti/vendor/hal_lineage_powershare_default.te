# PenguinOS: Lineage PowerShare HAL domain. AOSPA ships its own aospa
# powershare HAL sepolicy (hal_aospa_powershare), but the osm device tree ships
# the Lineage one (vendor.lineage.powershare-service.oplus), so declare its
# domain here. The hal_lineage_powershare attribute + service are provided by
# vendor/aospa/sepolicy.
type hal_lineage_powershare_default, domain;
hal_server_domain(hal_lineage_powershare_default, hal_lineage_powershare)

type hal_lineage_powershare_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lineage_powershare_default)

binder_call(hal_lineage_powershare_default, servicemanager)

rw_dir_file(hal_lineage_powershare_default, vendor_proc_wireless)
